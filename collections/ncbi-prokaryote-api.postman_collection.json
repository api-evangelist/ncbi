          "name": "Get a prokaryote gene data package by RefSeq protein accession",
          "request": {
            "name": "Get a prokaryote gene data package by RefSeq protein accession",
            "description": {
              "content": "Download a prokaryote gene data package including sequence, annotation and data reports by RefSeq non-redundant protein accession.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "protein",
                "accession",
                ":accessions",
                "download"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
